# Apache / LiteSpeed (Hostinger, cPanel hosts).
# Every route is prerendered to its own file (/work/some-project -> work/some-project.html).
# Anything else gets the prerendered 404 page.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # /work/some-project -> work/some-project.html, without a visible redirect
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
